{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "kimi-for-coding": {
      "name": "Kimi For Coding",
      "npm": "@ai-sdk/openai-compatible",
      "api": "https://api.kimi.com/coding/v1",
      "env": ["KIMI_API_KEY"],
      "options": {
        "apiKey": "${KIMI_API_KEY}",
        "baseURL": "https://api.kimi.com/coding/v1"
      },
      "models": {
        "k2p7": {
          "name": "Kimi K2.7 Code",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "limit": { "context": 262144, "output": 262144 }
        },
        "k2p5": {
          "name": "Kimi K2.5",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "limit": { "context": 262144, "output": 262144 }
        },
        "k2p6": {
          "name": "Kimi K2.6",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "limit": { "context": 262144, "output": 262144 }
        },
        "kimi-k2-thinking": {
          "name": "Kimi K2 Thinking",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "limit": { "context": 262144, "output": 262144 }
        }
      }
    }
  }
}
